APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000

# Relative paths are resolved from the repository root.
LAW_CORPUS_DIR=law/TUNISIA_LEGAL_BUSINESS_CORPUS
AID_CORPUS_DIR=grants_and_financial_aids
FRAUD_DATA_DIR=fraud_detection

# Planned local services. The scaffold does not call them yet.
OLLAMA_BASE_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333
MLFLOW_TRACKING_URI=http://localhost:5000

# Business plan (P4). The gateway reaches the service over HTTP and shares uploads by reference.
BP_SERVICE_URL=http://localhost:8104
UPLOADS_DIR=data/uploads
# Hosted models answer fast. Raise both only for a local model (see the Ollama block below).
BP_TIMEOUT_S=180
LLM_TIMEOUT_S=45

# ---- Model access for the bp service (OpenAI-compatible). Keep exactly ONE block active. ----

# Active: hosted Groq — no Ollama, no download, works on any machine. Paste your key below.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=<your-api-key>
LLM_MODEL_MAIN=llama-3.3-70b-versatile
LLM_MODEL_FAST=llama-3.1-8b-instant

# Inactive: local Ollama. Comment the Groq block above, uncomment these, and raise
# BP_TIMEOUT_S=600 / LLM_TIMEOUT_S=180 (local models are slow).
#   Bare metal: start Ollama, then ./start.bat  (or run uvicorn with this file as .env).
#   Docker: plain `docker compose up --build` also bundles Ollama and pulls the model on first boot.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL_MAIN=qwen2.5:7b
# LLM_MODEL_FAST=qwen2.5:7b

# With the Groq block active under Docker, start only the app containers (the bundled
# Ollama would otherwise be pulled and awaited for nothing):
#   docker compose up api bp --no-deps

# No model at all: set BP_LLM=off (deterministic checks and drafts still work).
