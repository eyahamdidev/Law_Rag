APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000

# Relative paths are resolved from the repository root.
LAW_CORPUS_DIR=law/TUNISIA_LEGAL_BUSINESS_CORPUS
AID_CORPUS_DIR=grants_and_financial_aids
FRAUD_DATA_DIR=fraud_detection
BUSINESS_PLAN_DIR=business_plan
DATA_DIR=data

# --- LLM providers (free tiers). Groq first, Gemini as fallback and for vision OCR.
# Groq key: https://console.groq.com/keys   Gemini key: https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=gemini
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=qwen/qwen3.8-27b
GROQ_COMPOSE_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite

# --- Retrieval. See docs/RETRIEVAL_EVAL.md for why these defaults.
CHUNK_STRATEGY=structural
RETRIEVAL_MODE=hybrid
EMBEDDING_MODEL=intfloat/multilingual-e5-base
USE_RERANKER=true
# GPU: cpu, or dml (Windows DirectML: pip uninstall onnxruntime && pip install --no-deps onnxruntime-directml).
# On laptops with Intel + NVIDIA graphics, the NVIDIA card is usually device 1.
EMBEDDING_DEVICE=cpu
EMBEDDING_DEVICE_ID=1
EMBEDDING_BATCH_SIZE=16
# Empty = embedded Qdrant under data/qdrant. Docker: http://qdrant:6333
QDRANT_URL=

# --- Business plan service (services/bp/, port 8104), OpenAI-compatible model access.
# Uses Groq with the same key as GROQ_API_KEY; models are ones a free Groq key can use.
BP_SERVICE_URL=http://localhost:8104
UPLOADS_DIR=data/uploads
BP_TIMEOUT_S=180
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL_MAIN=qwen/qwen3.8-27b
LLM_MODEL_FAST=qwen/qwen3.8-27b
LLM_TIMEOUT_S=45
# Groq's free tier has no vision model: chart reading from uploaded plans is off.
BP_LLM_STEPS=parser,reviewer,assessment,critic,drafts,plan_writer,final_writer

MLFLOW_TRACKING_URI=http://localhost:5000

# Optional key-free local model. Run scripts/prepare_local_runtime.py first.
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=local-legal
LEGAL_WEB_FALLBACK_ENABLED=false
