{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Legal assistant: API",
      "preLaunchTask": "Legal assistant: run stack (like run.cmd)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--app-dir", "backend", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
